{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode (Vite compiles; tsc only type-checks) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Mixed JS/TS codebase: existing .jsx stays as-is */
    "allowJs": true,
    "checkJs": false,
    "strict": true,

    /* shadcn-style import alias */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
